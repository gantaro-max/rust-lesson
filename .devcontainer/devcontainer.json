{
  "name": "RustLesson",
  "dockerComposeFile": "compose.yaml",
  "service": "rust_lesson",
  "workspaceFolder": "/lesson",
  "overrideCommand": true,
  "postCreateCommand": "sudo chown -R vscode:vscode /lesson/target",
  "containerEnv": {
    "LANG": "C.UTF-8"
  },
  "remoteEnv": {
    "LANG": "C.UTF-8",
    "HTTP_PROXY": "",
    "HTTPS_PROXY": "",
    "ALL_PROXY": "",
    "NO_PROXY": "localhost,127.0.0.1,::1,chatgpt.com,.chatgpt.com,auth.openai.com,.openai.com"
  },
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "anthropic.claude-code",
        "openai.chatgpt",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "vadimcn.vscode-lldb"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy"
      }
    }
  }
}